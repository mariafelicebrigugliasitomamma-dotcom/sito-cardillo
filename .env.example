# Credenziali di accesso al pannello di amministrazione (/admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=scegli-una-password-robusta

# Chiave segreta per firmare la sessione di login.
# Genera un valore casuale lungo, ad esempio con: openssl rand -base64 32
SESSION_SECRET=stringa-casuale-lunga-e-segreta

# Persistenza CMS su GitHub (source of truth in produzione)
# Token fine-grained con permessi Contents: Read and write SUL SOLO repository del sito.
GITHUB_TOKEN=github_pat_xxx
# Formato obbligatorio: owner/repo (es. account-cliente/repo)
GITHUB_REPO=owner/repo
# Branch da aggiornare (default: main)
GITHUB_BRANCH=main
